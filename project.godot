; Engine configuration file.
; Subway Lahore — original 3-lane endless runner (Godot 4.4.1, GDScript)
; All input is handled in code (scripts/main.gd) — no InputMap serialization needed.

config_version=5

[application]

config/name="Subway Lahore"
config/description="Original endless runner demo — Lahore-themed, built with 100% free tools and in-engine procedural assets."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.05, 0.05, 0.09, 1)
